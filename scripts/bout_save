#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import sys
import gc
import warnings
from pathlib import Path
import numpy as np
import argparse
from netCDF4 import Dataset

from boutdata.collect import collect
from boutdata.data import BoutData
from boututils.datafile import DataFile

HEAT_COEFF = 1.5  # 1.5 for internal-energy; use 2.5 for total enthalpy flux
EPS = 1e-30       # guard against division by ~zero gradient

def common_nt(data_dir):
    """Smallest time-record count across all dump files."""
    nts = []
    for f in sorted(Path(data_dir).glob("BOUT.dmp.*.nc")):
        with Dataset(f) as ds:
            nts.append(len(ds.dimensions["t"]))
    if not nts:
        raise FileNotFoundError(f"no BOUT.dmp.*.nc in {data_dir}")
    return min(nts), max(nts)

def safe_div(num, den, eps=EPS):
    """Divide, masking near-zero denominators to NaN instead of inf."""
    num = np.asarray(num, dtype=float)
    den = np.asarray(den, dtype=float)
    bad = ~np.isfinite(den) | (np.abs(den) < eps)
    out = np.divide(num, np.where(bad, 1.0, den))
    out[bad] = np.nan
    return out

def effective_coeff(flux_txy, grad_txy):
    """Flux-averaged effective transport coefficient.

    Averages numerator and denominator over time SEPARATELY before dividing.
    This is the quantity comparable to published chi_perp / D_perp; a mean of
    pointwise instantaneous ratios is not.
    """
    return -safe_div(np.nanmean(flux_txy, axis=0),
                     np.nanmean(grad_txy, axis=0))

def save_variable(data_dir, numpy_dir, key, time):
    """
    Collect a single BOUT++ variable, optionally slice in time,
    save to disk, then free memory.
    """
    var_fname = Path(numpy_dir) / f"{key}.npy"

    if var_fname.exists():
        print(f"{key} (exists)")
        return

    print(f"Collecting {key}")
    nt_min, nt_max = common_nt(data_dir)
    if nt_min != nt_max:
        print(f"  ! ragged dumps: nt varies {nt_min}..{nt_max}; truncating to {nt_min}")
    arr = collect(key, path=data_dir, info=False, tind=[0, nt_min - 1])

    if time[0] != "All" and arr.ndim > 0:
        arr = arr[time, ...]

    np.save(var_fname, arr)

    del arr
    gc.collect()


def load_var(numpy_dir, name):
    return np.load(Path(numpy_dir) / f"{name}.npy", mmap_mode="r")

# ---------------------------------------------------------------------------
# Transport-coefficient conventions
#
#   Particles:  Gamma_r = -D  * dn/dr        =>  D    = -n V_r / (dn/dr)
#   Heat:       q_r     = -n*chi* dT/dr      =>  chi  = -C * T V_r / (dT/dr)
#
#   where q_r = C * n * T * V_r, with
#       C = 3/2  -> conductive / internal-energy channel
#       C = 5/2  -> total enthalpy flux
#
#   Density CANCELS in chi. Do not multiply by ni.
# --------------------------------------------------------------------------

def bout_save_data(data_dir, grid_fname, var_names, time, debug):

    numpy_dir = Path(data_dir) / "numpy"
    numpy_dir.mkdir(exist_ok=True)

    d = BoutData(path=data_dir)
    output_keys = d["outputs"].keys()

    def save_debug(name, arr):
        """Write an intermediate array only when debugging."""
        if debug:
            np.save(numpy_dir / f"{name}.npy", arr)

    # -------------------------
    # 1. SAVE RAW VARIABLES
    # -------------------------
    print("Saving raw BOUT++ outputs")

    if var_names[0] == "All":
        keys_to_save = output_keys
    else:
        keys_to_save = var_names

    for key in keys_to_save:
        save_variable(data_dir, numpy_dir, key, time)

    # -------------------------
    # 2. LOAD GRID (small)
    # -------------------------
    with DataFile(grid_fname) as g:
        Rxy = g["Rxy"]
        Zxy = g["Zxy"]
        Bpxy = g["Bpxy"]
        Btxy = g["Btxy"]

    # -------------------------
    # 3. DERIVED PROFILES
    # -------------------------
    print("Computing derived quantities")

    def compute_txy_xy(base, fluct):
        txy = base + np.sum(fluct, axis=3) / fluct.shape[3]
        xy = np.sum(txy, axis=0) / txy.shape[0]
        return txy, xy

    def zonal_txy_xy(arr):
        """Toroidal (z) average then time average."""
        txy = np.sum(arr, axis=3) / arr.shape[3]
        xy = np.sum(txy, axis=0) / txy.shape[0]
        return txy, xy

    # ---- Density
    if "N0" in output_keys and "Ni" in output_keys:
        N0 = load_var(numpy_dir, "N0")
        Ni = load_var(numpy_dir, "Ni")

        ni_txy, ni_xy = compute_txy_xy(N0, Ni)

        np.save(numpy_dir / "ni_txy.npy", ni_txy)
        np.save(numpy_dir / "ni_xy.npy", ni_xy)

        del N0, Ni, ni_txy, ni_xy
        gc.collect()

    # ---- Ion temperature
    if "Ti0" in output_keys and "Ti" in output_keys:
        Ti0 = load_var(numpy_dir, "Ti0")
        Ti = load_var(numpy_dir, "Ti")

        Ti_txy, Ti_xy = compute_txy_xy(Ti0, Ti)

        np.save(numpy_dir / "Ti_txy.npy", Ti_txy)
        np.save(numpy_dir / "Ti_xy.npy", Ti_xy)

        del Ti0, Ti, Ti_txy, Ti_xy
        gc.collect()

    # ---- Electron temperature
    if "Te0" in output_keys and "Te" in output_keys:
        Te0 = load_var(numpy_dir, "Te0")
        Te = load_var(numpy_dir, "Te")

        Te_txy, Te_xy = compute_txy_xy(Te0, Te)

        np.save(numpy_dir / "Te_txy.npy", Te_txy)
        np.save(numpy_dir / "Te_xy.npy", Te_xy)

        del Te0, Te, Te_txy, Te_xy
        gc.collect()

    # -------------------------
    # 4. VELOCITIES
    # -------------------------
    if "Vexbx" in output_keys and "Vbtildx" in output_keys:

        Vexbx = load_var(numpy_dir, "Vexbx")
        Vbtildx = load_var(numpy_dir, "Vbtildx")

        Vexbx_txy, Vexbx_xy = zonal_txy_xy(Vexbx)
        Vbtildx_txy, Vbtildx_xy = zonal_txy_xy(Vbtildx)

        np.save(numpy_dir / "Vexbx_txy.npy", Vexbx_txy)
        np.save(numpy_dir / "Vexbx_xy.npy", Vexbx_xy)
        np.save(numpy_dir / "Vbtildx_txy.npy", Vbtildx_txy)
        np.save(numpy_dir / "Vbtildx_xy.npy", Vbtildx_xy)

        del Vexbx, Vbtildx, Vexbx_txy, Vbtildx_txy, Vexbx_xy, Vbtildx_xy
        gc.collect()

    # -------------------------
    # ddr_nitot
    # -------------------------
    if "ddr_nitot" in output_keys:

        ddr_nitot = load_var(numpy_dir, "ddr_nitot")
        ddr_nitot_txy, ddr_nitot_xy = zonal_txy_xy(ddr_nitot)

        np.save(numpy_dir / "ddr_nitot_txy.npy", ddr_nitot_txy)
        np.save(numpy_dir / "ddr_nitot_xy.npy", ddr_nitot_xy)

        del ddr_nitot, ddr_nitot_txy, ddr_nitot_xy
        gc.collect()

    # -------------------------
    # ddr_Titot
    # -------------------------
    if "ddr_Titot" in output_keys:

        ddr_Titot = load_var(numpy_dir, "ddr_Titot")
        ddr_Titot_txy, ddr_Titot_xy = zonal_txy_xy(ddr_Titot)

        np.save(numpy_dir / "ddr_Titot_txy.npy", ddr_Titot_txy)
        np.save(numpy_dir / "ddr_Titot_xy.npy", ddr_Titot_xy)

        del ddr_Titot, ddr_Titot_txy, ddr_Titot_xy
        gc.collect()

    # -------------------------
    # ddr_Tetot
    # -------------------------
    if "ddr_Tetot" in output_keys:

        ddr_Tetot = load_var(numpy_dir, "ddr_Tetot")
        ddr_Tetot_txy, ddr_Tetot_xy = zonal_txy_xy(ddr_Tetot)

        np.save(numpy_dir / "ddr_Tetot_txy.npy", ddr_Tetot_txy)
        np.save(numpy_dir / "ddr_Tetot_xy.npy", ddr_Tetot_xy)

        del ddr_Tetot, ddr_Tetot_txy, ddr_Tetot_xy
        gc.collect()

    # -------------------------
    # 5. TRANSPORT COEFFICIENTS
    # -------------------------
    required = [
        "ni_xy", "ni_txy",
        "Ti_xy", "Ti_txy",
        "Te_xy", "Te_txy",
        "ddr_nitot_xy", "ddr_nitot_txy",
        "ddr_Titot_xy", "ddr_Titot_txy",
        "ddr_Tetot_xy", "ddr_Tetot_txy",
        "Vexbx_xy", "Vexbx_txy",
        "Vbtildx_xy", "Vbtildx_txy",
    ]
    missing = [k for k in required if not (numpy_dir / f"{k}.npy").exists()]
    if missing:
        print(f"Skipping transport coefficients; missing: {', '.join(missing)}")
        return

    print("Computing transport coefficients")
    if debug:
        print("  debug=True: writing all intermediate arrays")

    Va = load_var(numpy_dir, "Va")
    Nbar = 1e20

    # ---- radial velocity: ExB + magnetic flutter, converted to m/s
    Vexbx_xy = load_var(numpy_dir, "Vexbx_xy")
    Vbtildx_xy = load_var(numpy_dir, "Vbtildx_xy")
    Vr = (Vexbx_xy + Vbtildx_xy) * Va
    del Vexbx_xy, Vbtildx_xy

    Vexbx_txy = load_var(numpy_dir, "Vexbx_txy")
    Vbtildx_txy = load_var(numpy_dir, "Vbtildx_txy")
    Vr_t = (Vexbx_txy + Vbtildx_txy) * Va
    del Vexbx_txy, Vbtildx_txy
    gc.collect()

    save_debug("Vr", Vr)
    save_debug("Vr_t", Vr_t)

    # ---- particle diffusivity:  D = -n V_r / (dn/dr)
    ni_xy = load_var(numpy_dir, "ni_xy")
    ddr_nitot_xy = load_var(numpy_dir, "ddr_nitot_xy")

    Da = -safe_div(ni_xy * Vr, ddr_nitot_xy)
    np.save(numpy_dir / "Da.npy", Da)

    del ni_xy, ddr_nitot_xy, Da
    gc.collect()

    ni_txy = load_var(numpy_dir, "ni_txy")
    ddr_nitot_txy = load_var(numpy_dir, "ddr_nitot_txy")

    gamma_t = ni_txy * Vr_t                                  # particle flux
    Da_eff = effective_coeff(gamma_t, ddr_nitot_txy)
    np.save(numpy_dir / "Da_eff.npy", Da_eff)

    save_debug("gamma_t", gamma_t)
    save_debug("Da_t", -safe_div(gamma_t, ddr_nitot_txy))     # instantaneous

    del ni_txy, ddr_nitot_txy, gamma_t, Da_eff
    gc.collect()
    
# ---- electron heat diffusivity:  chi = -C T V_r / (dT/dr)
    Te_xy = load_var(numpy_dir, "Te_xy")
    ddr_Tetot_xy = load_var(numpy_dir, "ddr_Tetot_xy")

    Xe = -HEAT_COEFF * safe_div(Te_xy * Vr, ddr_Tetot_xy)
    np.save(numpy_dir / "Xe.npy", Xe)

    del Te_xy, ddr_Tetot_xy, Xe
    gc.collect()

    Te_txy = load_var(numpy_dir, "Te_txy")
    ddr_Tetot_txy = load_var(numpy_dir, "ddr_Tetot_txy")

    qe_t = HEAT_COEFF * Te_txy * Vr_t                         # heat flux / n
    Xe_eff = effective_coeff(qe_t, ddr_Tetot_txy)
    np.save(numpy_dir / "Xe_eff.npy", Xe_eff)

    save_debug("qe_t", qe_t)
    save_debug("Xe_t", -safe_div(qe_t, ddr_Tetot_txy))        # instantaneous

    del Te_txy, ddr_Tetot_txy, qe_t, Xe_eff
    gc.collect()

    # ---- ion heat diffusivity
    Ti_xy = load_var(numpy_dir, "Ti_xy")
    ddr_Titot_xy = load_var(numpy_dir, "ddr_Titot_xy")

    Xi = -HEAT_COEFF * safe_div(Ti_xy * Vr, ddr_Titot_xy)
    np.save(numpy_dir / "Xi.npy", Xi)

    del Ti_xy, ddr_Titot_xy, Xi
    gc.collect()

    Ti_txy = load_var(numpy_dir, "Ti_txy")
    ddr_Titot_txy = load_var(numpy_dir, "ddr_Titot_txy")

    qi_t = HEAT_COEFF * Ti_txy * Vr_t
    Xi_eff = effective_coeff(qi_t, ddr_Titot_txy)
    np.save(numpy_dir / "Xi_eff.npy", Xi_eff)

    save_debug("qi_t", qi_t)
    save_debug("Xi_t", -safe_div(qi_t, ddr_Titot_txy))        # instantaneous

    del Ti_txy, ddr_Titot_txy, qi_t, Xi_eff
    gc.collect()

    del Va, Vr, Vr_t
    gc.collect()

    print("Done")


if __name__ == "__main__":

    vars_for_Da_calculation = ["N0", "Ni", "Ti", "Ti0", "Te", "Te0", "Va", "U", "Phi",
                               "ddr_nitot", "ddr_Titot", "ddr_Tetot", "Vexbx", "Vbtildx"]

    def flag(v):  # "False"/"0"/"no" -> False
        return str(v).lower() not in ("false", "0", "no", "n", "")

    parser = argparse.ArgumentParser(prog="bout_save")
    parser.add_argument("path", nargs="?", type=Path, default=Path("."),
                        help="BOUT++ data directory (default: cwd)")
    parser.add_argument("-v", "--vars", nargs="+", default=vars_for_Da_calculation)
    parser.add_argument("-t", "--time", nargs="+", default=["All"])
    parser.add_argument("-d", "--debug", type=flag, default=True)
    parser.add_argument("-c", "--clean", type=flag, default=False)
    args = parser.parse_args()
    
    with open("BOUT.inp") as f:
        for line in f:
            if "grid =" in line:
                grid_fname = Path(os.path.expandvars(line.split('"')[1]))
                break
            elif "file =" in line:
                grid_fname = Path(os.path.expandvars(line.split('"')[1]))
                break
    
    bout_save_data(str(args.path), str(grid_fname), args.vars, args.time, args.debug)
    if args.clean:
        numpy_dir = Path(str(args.path)) / "numpy"
        npy_files = os.listdir(path=numpy_dir)
        for file in npy_files:
            if file not in ["Da.npy", "Da_t.npy", "Ti0.npy", "Te0.npy", "N0.npy", "U.npy", "Phi.npy"]:
                print(f"Cleaning up: {file}")
                os.remove(numpy_dir / file)
