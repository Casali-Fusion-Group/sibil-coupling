#!/usr/bin/env python3
import argparse
import glob
import os
import tarfile

PATTERNS = ["BOUT.dmp.*", "BOUT.log.*", "BOUT.failed.*", "BOUT.restart.*"]

parser = argparse.ArgumentParser(description="Compress and remove BOUT++ output files.")
parser.add_argument("dir")
parser.add_argument("--no-save", action="store_true", help="remove files without compressing")
args = parser.parse_args()

files = sorted(f for p in PATTERNS for f in glob.glob(os.path.join(args.dir, p)))

if not args.no_save:
    archive = os.path.join(args.dir, "bout_output.tar.gz")
    with tarfile.open(archive, "w:gz") as tar:
        for f in files:
            tar.add(f, arcname=os.path.basename(f))

for f in files:
    os.remove(f)
