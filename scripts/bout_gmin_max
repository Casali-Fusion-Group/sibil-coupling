#!/usr/bin/env python3# -*- coding: utf-8 -*-"""Created on Thu Nov 14 11:43:14 2024@author: ttaczak"""from boututils.datafile import DataFileimport numpy as npprint("Opening grid")bgrid_loc="/global/cfs/projectdirs/m4491/btaczak/bout-runs/r7_new_grid_test/d3d_184016.3200_nx260ny64_new.grd.nc"with DataFile(bgrid_loc, write=False) as grid:    print("Getting gxx")    g11 = grid["g11"]    g12 = grid["g12"]    g13 = grid["g13"]    g22 = grid["g22"]    g23 = grid["g23"]    g33 = grid["g33"]        print("Getting g_xx")    g_11 = grid["g_11"]    g_12 = grid["g_12"]    g_13 = grid["g_13"]    g_22 = grid["g_22"]    g_23 = grid["g_23"]    g_33 = grid["g_33"]    print("BEFORE CHANGING")print(f"Max g11: {np.max(g11):.3f}\nMin g11: {np.min(g11):.3f}")print(f"Max g12: {np.max(g12):.3f}\nMin g12: {np.min(g12):.3f}")print(f"Max g13: {np.max(g13):.3f}\nMin g13: {np.min(g13):.3f}")print(f"Max g22: {np.max(g22):.3f}\nMin g22: {np.min(g22):.3f}")print(f"Max g23: {np.max(g23):.3f}\nMin g23: {np.min(g23):.3f}")print(f"Max g33: {np.max(g33):.3f}\nMin g33: {np.min(g33):.3f}")print(f"Max g_11: {np.max(g11):.3f}\nMin g_11: {np.min(g11):.3f}")print(f"Max g_12: {np.max(g12):.3f}\nMin g_12: {np.min(g12):.3f}")print(f"Max g_13: {np.max(g13):.3f}\nMin g_13: {np.min(g13):.3f}")print(f"Max g_22: {np.max(g22):.3f}\nMin g_22: {np.min(g22):.3f}")print(f"Max g_23: {np.max(g23):.3f}\nMin g_23: {np.min(g23):.3f}")print(f"Max g_33: {np.max(g33):.3f}\nMin g_33: {np.min(g33):.3f}")print("Opening grid")with DataFile(bgrid_loc, write=True) as grid:    print("Setting gxx")    grid["g11"] = np.abs(grid["g11"])    grid["g12"] = np.abs(grid["g12"])    grid["g13"] = np.abs(grid["g13"])    grid["g22"] = np.abs(grid["g22"])    grid["g23"] = np.abs(grid["g23"])    grid["g33"] = np.abs(grid["g33"])        print("Setting g_xx")    grid["g_11"] = np.abs(grid["g_11"])    grid["g_12"] = np.abs(grid["g_12"])    grid["g_13"] = np.abs(grid["g_13"])    grid["g_22"] = np.abs(grid["g_22"])    grid["g_23"] = np.abs(grid["g_23"])    grid["g_33"] = np.abs(grid["g_33"])    print("AFTER CHANGING")print(f"Max g11: {np.max(g11):.3f}\nMin g11: {np.min(g11):.3f}")print(f"Max g12: {np.max(g12):.3f}\nMin g12: {np.min(g12):.3f}")print(f"Max g13: {np.max(g13):.3f}\nMin g13: {np.min(g13):.3f}")print(f"Max g22: {np.max(g22):.3f}\nMin g22: {np.min(g22):.3f}")print(f"Max g23: {np.max(g23):.3f}\nMin g23: {np.min(g23):.3f}")print(f"Max g33: {np.max(g33):.3f}\nMin g33: {np.min(g33):.3f}")print(f"Max g_11: {np.max(g11):.3f}\nMin g_11: {np.min(g11):.3f}")print(f"Max g_12: {np.max(g12):.3f}\nMin g_12: {np.min(g12):.3f}")print(f"Max g_13: {np.max(g13):.3f}\nMin g_13: {np.min(g13):.3f}")print(f"Max g_22: {np.max(g22):.3f}\nMin g_22: {np.min(g22):.3f}")print(f"Max g_23: {np.max(g23):.3f}\nMin g_23: {np.min(g23):.3f}")print(f"Max g_33: {np.max(g33):.3f}\nMin g_33: {np.min(g33):.3f}")        